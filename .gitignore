# Installed tooling only. `client.xterm.js` is a committed build output, so it is
# deliberately absent from this list: the package ships it and must stay diffable.
node_modules/
*.log
.DS_Store
Thumbs.db

# The profile links this checkout with pnpm, which would rewrite this file on
# every install. npm's `package-lock.json` is the lockfile CI installs from.
pnpm-lock.yaml

# Scratch files from local probing.
#
# Prefer this over /tmp when a probe needs to import the plugin by relative path,
# and delete the directory when done. It has already happened once that a commit
# message file written to the repo root was swept in by `git add -A`.
.probe-*/
*.msg.txt
